<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AutoClic.App</RootNamespace>
    <AssemblyName>AutoClic</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AutoClic.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- WindowsAppSDKSelfContained exige un RID dès la compilation ; win-x64 par
         défaut, surchargeable avec « dotnet build -r win-arm64 ». -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWinUI>true</UseWinUI>

    <!-- Déploiement non empaqueté : pas de MSIX, l'application se lance depuis un
         simple dossier. WindowsAppSDKSelfContained embarque le runtime WinUI, ce qui
         évite d'installer le Windows App SDK sur chaque poste. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- true sélectionne les cibles MSIX/PRI livrées dans le paquet NuGet, qui
         génèrent resources.pri via makepri. À false, le Windows App SDK retombe sur
         les anciennes cibles MrtCore, qui réclament les tâches d'empaquetage APPX de
         Visual Studio — absentes d'un SDK .NET seul. Aucun MSIX n'est produit pour
         autant : WindowsPackageType=None reste maître. -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationIcon grave l'icône dans l'exe, ce qui suffit à l'Explorateur et à
         la barre des tâches. La barre de titre, elle, charge ms-appx:///Assets/… —
         un fichier posé à côté de l'exe. Sans cette copie explicite, il survit en
         Debug par accident et disparaît de la publication : l'icône s'évanouit dans
         la fenêtre, mais nulle part ailleurs, donc rien ne le signale avant l'install. -->
    <Content Include="Assets\AutoClic.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoClic.Core\AutoClic.Core.csproj" />
    <ProjectReference Include="..\AutoClic.Localization\AutoClic.Localization.csproj" />
  </ItemGroup>

</Project>
