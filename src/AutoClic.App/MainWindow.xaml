<Window
    x:Class="AutoClic.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AutoClic.App"
    xmlns:loc="using:AutoClic.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AutoClic">

    <Grid RowDefinitions="Auto,*">

        <Grid.Resources>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <Style x:Key="HintStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <!-- Barre de titre personnalisée. L'icône est délibérément hors de l'élément
             déclaré à SetTitleBar : tout ce qui s'y trouve est traité comme zone de
             glisser et ne recevrait jamais de clic. -->
        <Grid Grid.Row="0" Height="40" ColumnDefinitions="Auto,*">

            <!-- IsTabStop=False : aucune fenêtre Windows ne commence sa navigation
                 clavier sur le menu système. Il s'atteint par Alt+Espace. -->
            <Button
                x:Name="AppIconButton"
                Grid.Column="0"
                Width="40"
                Height="40"
                Padding="0"
                CornerRadius="0"
                Background="Transparent"
                BorderThickness="0"
                IsTabStop="False"
                Click="OnAppIconClick"
                RightTapped="OnAppIconRightTapped"
                AutomationProperties.Name="{x:Bind Loc.Get('action.systemMenu'), Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Loc.Get('action.systemMenu.tip'), Mode=OneWay}">
                <Image Width="16" Height="16">
                    <Image.Source>
                        <BitmapImage
                            UriSource="ms-appx:///Assets/AutoClic.ico"
                            DecodePixelWidth="16"
                            DecodePixelHeight="16" />
                    </Image.Source>
                </Image>
            </Button>

            <!-- Aucun gestionnaire de clic droit ici : cet élément est déclaré à
                 SetTitleBar, donc traité comme zone non cliente, et Windows y affiche
                 déjà le menu système de lui-même. -->
            <Grid x:Name="AppTitleBar" Grid.Column="1">
                <TextBlock
                    Text="AutoClic"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    VerticalAlignment="Center"
                    Margin="4,0" />
            </Grid>
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="20,4,20,16"
            RowSpacing="14"
            ColumnSpacing="14"
            RowDefinitions="Auto,*,Auto"
            ColumnDefinitions="392,*">

            <!-- En-tête : identité à gauche, commandes de transport à droite -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Loc.Get('app.title'), Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Loc.Get('app.subtitle'), Mode=OneWay}" Style="{StaticResource HintStyle}" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="RecordButton" Click="OnRecordClick" MinWidth="126">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7C8;" FontSize="13" Foreground="#E04B4B" />
                                <TextBlock Text="{x:Bind Loc.Get('action.record'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="StopButton" Click="OnStopClick" IsEnabled="False" MinWidth="104">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="13" />
                                <TextBlock Text="{x:Bind Loc.Get('action.stop'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <AppBarSeparator Margin="2,0" />

                        <Button
                            x:Name="SimulateButton"
                            Click="OnSimulateClick"
                            IsEnabled="False"
                            MinWidth="106"
                            ToolTipService.ToolTip="{x:Bind Loc.Get('action.simulate.tip'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7B3;" FontSize="13" />
                                <TextBlock Text="{x:Bind Loc.Get('action.simulate'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="PlayButton"
                            Click="OnPlayClick"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            MinWidth="110">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="13" />
                                <TextBlock Text="{x:Bind Loc.Get('action.play'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Colonne des réglages -->
            <ScrollViewer
                Grid.Row="1"
                Grid.Column="0"
                VerticalScrollBarVisibility="Auto"
                Padding="0,0,4,0">
                <StackPanel Spacing="14">

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{x:Bind Loc.Get('target.title'), Mode=OneWay}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{x:Bind Loc.Get('target.hint'), Mode=OneWay}" Style="{StaticResource HintStyle}" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ComboBox
                                    x:Name="TargetCombo"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind Targets}"
                                    DisplayMemberPath="Label"
                                    SelectionChanged="OnTargetChanged" />

                                <Button
                                    x:Name="RefreshTargetsButton"
                                    Grid.Column="1"
                                    Click="OnRefreshTargetsClick"
                                    ToolTipService.ToolTip="{x:Bind Loc.Get('action.refresh.tip'), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </Grid>

                            <ComboBox
                                x:Name="AnchorCombo"
                                Header="{x:Bind Loc.Get('target.resize'), Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0">
                                <ComboBoxItem Content="{x:Bind Loc.Get('target.anchor.nearest'), Mode=OneWay}" />
                                <ComboBoxItem Content="{x:Bind Loc.Get('target.anchor.topLeft'), Mode=OneWay}" />
                                <ComboBoxItem Content="{x:Bind Loc.Get('target.anchor.scale'), Mode=OneWay}" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{x:Bind Loc.Get('reference.title'), Mode=OneWay}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{x:Bind Loc.Get('reference.hint'), Mode=OneWay}" Style="{StaticResource HintStyle}" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="PickReferenceButton"
                                    Content="{x:Bind Loc.Get('reference.define'), Mode=OneWay}"
                                    Click="OnPickReferenceClick"
                                    IsEnabled="False" />
                                <Button
                                    x:Name="ClearReferenceButton"
                                    Content="{x:Bind Loc.Get('reference.remove'), Mode=OneWay}"
                                    Click="OnClearReferenceClick"
                                    IsEnabled="False" />
                            </StackPanel>

                            <Border
                                x:Name="ReferenceBorder"
                                Visibility="Collapsed"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                HorizontalAlignment="Left"
                                Padding="4">
                                <Image x:Name="ReferenceImage" MaxHeight="56" Stretch="Uniform" />
                            </Border>

                            <TextBlock x:Name="ReferenceText" Style="{StaticResource HintStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{x:Bind Loc.Get('playback.title'), Mode=OneWay}" Style="{StaticResource SectionTitleStyle}" />

                            <ToggleSwitch
                                x:Name="MouseMoveToggle"
                                Header="{x:Bind Loc.Get('playback.mouseMoves'), Mode=OneWay}"
                                OnContent="{x:Bind Loc.Get('playback.mouseMoves.on'), Mode=OneWay}"
                                OffContent="{x:Bind Loc.Get('playback.mouseMoves.off'), Mode=OneWay}"
                                IsOn="True" />

                            <TextBlock Text="{x:Bind Loc.Get('playback.mouseMoves.hint'), Mode=OneWay}" Style="{StaticResource HintStyle}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <NumberBox
                                    x:Name="RepeatBox"
                                    Header="{x:Bind Loc.Get('playback.repeat'), Mode=OneWay}"
                                    Value="1"
                                    Minimum="1"
                                    Maximum="10000"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact" />

                                <NumberBox
                                    x:Name="SpeedBox"
                                    Grid.Column="1"
                                    Header="{x:Bind Loc.Get('playback.speed'), Mode=OneWay}"
                                    Value="1"
                                    Minimum="0.1"
                                    Maximum="20"
                                    SmallChange="0.25"
                                    SpinButtonPlacementMode="Compact" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{x:Bind Loc.Get('macro.title'), Mode=OneWay}" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="CleanButton"
                                    Content="{x:Bind Loc.Get('action.clean'), Mode=OneWay}"
                                    Click="OnCleanClick"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="{x:Bind Loc.Get('action.clean.tip'), Mode=OneWay}" />
                                <Button x:Name="OpenButton" Content="{x:Bind Loc.Get('action.open'), Mode=OneWay}" Click="OnOpenClick" />
                                <Button x:Name="SaveButton" Content="{x:Bind Loc.Get('action.save'), Mode=OneWay}" Click="OnSaveClick" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind Loc.Get('action.language'), Mode=OneWay}" Style="{StaticResource SectionTitleStyle}" />
                            <ComboBox
                                x:Name="LanguageCombo"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind Loc.Languages, Mode=OneWay}"
                                DisplayMemberPath="DisplayName"
                                SelectionChanged="OnLanguageChanged" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Colonne du détail -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid RowDefinitions="Auto,*">

                    <Grid Grid.Row="0" Padding="16,14" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{x:Bind Loc.Get('events.title'), Mode=OneWay}" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="10"
                            Padding="10,2">
                            <TextBlock x:Name="EventCountText" Text="0" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                    </Grid>

                    <ListView
                        x:Name="EventList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind Rows}"
                        SelectionMode="None"
                        Padding="8,0,8,8">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:EventRow">
                                <Grid ColumnSpacing="12" ColumnDefinitions="44,74,*" Padding="0,5">
                                    <TextBlock
                                        Text="{x:Bind Index}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Right" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind DelayText}"
                                        FontFamily="Consolas"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        x:Name="EmptyState"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        Margin="32">
                        <FontIcon Glyph="&#xE7C8;" FontSize="30" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="{x:Bind Loc.Get('events.empty.title'), Mode=OneWay}"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="{x:Bind Loc.Get('events.empty.hint'), Mode=OneWay}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            MaxWidth="300"
                            Style="{StaticResource HintStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- État -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
                <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" />
                <TextBlock x:Name="StatusText" Style="{StaticResource HintStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
